{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "cypress:open": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-gpu --disable-software-rasterizer\" cypress open",
    "cypress:run": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-gpu --disable-software-rasterizer\" cypress run",
    "cypress:headed": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-gpu --disable-software-rasterizer\" cypress run --headed",
    "cypress:record": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-gpu --disable-software-rasterizer\" cypress run --record",
    "cypress:open:slow": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-gpu --disable-software-rasterizer\" cypress open --expose SLOW_MO=800",
    "cypress:headed:slow": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-gpu --disable-software-rasterizer\" cypress run --headed --no-exit --expose SLOW_MO=800",
    "cypress:match-flow": "node test/cypress/scripts/run-match-flow.ts",
    "playwright:pw": "playwright test",
    "playwright:pw:ui": "playwright test --ui",
    "playwright:pw:headed": "playwright test --headed",
    "playwright:pw:pwa": "playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/vue-query": "^5.104.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
