# Konfigurasi stack DEMO (docker-compose.demo.yml). Salin ke .env.demo (diabaikan git); jangan pakai nilai stack lomba.
# ENV, SEED_DATA, PORT, dan DB_URL sudah diatur di compose.

# Database demo. Hanya dibaca saat volume demo pertama dibuat. Pakai hex: openssl rand -hex 24
POSTGRES_USER=demo_user
POSTGRES_DB=demo_scoring
POSTGRES_PASSWORD=

# Kunci token login demo. Isi acak walau ini hanya demo: openssl rand -base64 48
JWT_SECRET=

# Token tunnel khusus demo (Zero Trust -> Networks -> Tunnels -> Install connector). Buat tunnel BARU, jangan
# berbagi dengan tunnel lain.
CLOUDFLARE_TUNNEL_TOKEN=

# Opsional: port loopback untuk mengecek demo dari server (http://127.0.0.1:8090).
#DEMO_WEB_PORT=8090
