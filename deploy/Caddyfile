# HTTPS untuk Digital Scoring (PWA wajib HTTPS). Dipakai oleh layanan `caddy` (docker compose --profile https).
# Semua pengaturan dari .env.prod:
#   SITE_ADDRESS   domain atau IP yang dibuka tablet, mis. silat.contoh.id  atau  192.168.1.10
#   TLS_DIRECTIVE  kosong  -> sertifikat Let's Encrypt otomatis (domain publik)
#                  "tls internal" -> CA internal Caddy (LAN tertutup / IP); root CA harus dipasang di tiap tablet
{$SITE_ADDRESS} {
	{$TLS_DIRECTIVE}

	# Frontend + API + WebSocket semuanya lewat nginx (layanan `web`). Caddy meneruskan WebSocket otomatis dan
	# mengirim X-Forwarded-For dengan IP klien asli; nginx memakainya (lihat set_real_ip_from di nginx.conf) agar
	# pembatas percobaan login/PIN membedakan tiap tablet, bukan menganggap semuanya satu IP (kontainer Caddy).
	reverse_proxy web:80
}
