# Salin menjadi `.env` (berkas .env tidak masuk git) lalu sesuaikan.
#   cp .env.example .env
# Template untuk dua berkas (keduanya tidak masuk git):
#   .env       development: dibaca backend saat `go run` (godotenv)
#   .env.prod  produksi:    cp .env.example .env.prod, lalu  docker compose --env-file .env.prod up -d --build
# Compose WAJIB punya .env.prod (`env_file` layanan `app`); PORT, ENV, dan DB_URL ditimpa compose karena nilai
# di dalam container berbeda. Nilai bawaan job CI sama dengan berkas ini (bisa ditimpa Repository Variables
# GitHub bernama sama; lihat README).

# --- Backend (internal/config) ---
PORT=8080
ENV=development            # development | production
AUTO_MIGRATE=true
SEED_DATA=false
# Kunci penanda token login. Nilai di bawah hanya untuk development: dengan ENV=production backend
# menolak start (dan docker compose berhenti) bila kosong, masih nilai contoh, atau < 32 karakter.
# Buat nilai acak: openssl rand -base64 48   (PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 })))
JWT_SECRET=dev-secret-change-in-prod

# Token untuk /metrics (Prometheus). Kosong = /metrics hanya dari localhost; terisi = wajib header Authorization: Bearer <token>.
METRICS_TOKEN=

# --- PostgreSQL (docker compose dan CI membuat database dengan nama dan pengguna ini) ---
POSTGRES_USER=scoring_user
POSTGRES_DB=digital_scoring
# DB_URL dipakai backend saat dijalankan langsung di host (`go run ./cmd/server`).
# Di dalam docker compose, DB_URL dirakit otomatis dari POSTGRES_USER dan POSTGRES_DB.
DB_URL=postgres://scoring_user@localhost:5432/digital_scoring?sslmode=disable

# --- Port yang dibuka di host (docker compose) ---
WEB_PORT=80                # frontend + proxy (pintu masuk utama)
APP_PORT=8080              # backend langsung; hapus pemetaan ini di produksi
POSTGRES_PORT=5432
