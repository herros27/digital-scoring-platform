# ==============================================================================================================
# DigitalScoring: contoh konfigurasi. Tidak berisi rahasia; salin, lalu sesuaikan.
# ==============================================================================================================
# Berkas ini adalah template untuk DUA berkas (keduanya diabaikan git):
#
#   DEVELOPMENT  cp .env.example .env
#       Dibaca backend saat `go run ./cmd/server` dan `go run ./cmd/seed` (godotenv), oleh tes Go (DB_URL), dan oleh
#       docker compose untuk interpolasi (`docker compose up -d postgres`). Nilai di bawah SUDAH benar untuk
#       development; tidak ada yang wajib diubah.
#
#   PRODUKSI     cp .env.example .env.prod
#       docker compose --env-file .env.prod up -d --build              (tanpa HTTPS)
#       docker compose --env-file .env.prod --profile https up -d --build   (dengan HTTPS: Caddy)
#       Ubah setiap baris bertanda [PRODUKSI] di bawah (cari kata PRODUKSI). Compose WAJIB punya .env.prod (env_file
#       layanan `app`). Di dalam container, PORT, ENV, dan DB_URL ditimpa compose.
#
# Penjaga: di luar ENV=development backend menolak start bila JWT_SECRET kosong/contoh/pendek, DB_URL tanpa password
# atau berpassword contoh, atau SEED_DATA=true. ENV kosong dianggap production.
#
# Ringkasan nilai:
#   Variabel           Development                              Produksi
#   ENV                development                              production
#   SEED_DATA          true (run pertama) lalu false            false
#   JWT_SECRET         contoh (dev-secret-change-in-prod)       acak, minimal 32 karakter
#   POSTGRES_PASSWORD  contoh                                   acak (hex), simpan baik-baik
#   ADMIN_EMAIL/PASS   tidak perlu (seed membuat akun demo)     wajib untuk admin pertama
#   WEB_PORT           80                                       127.0.0.1:8081 bila memakai HTTPS (Caddy)
# Nilai bawaan job CI sama dengan berkas ini (bisa ditimpa Repository Variables GitHub bernama sama; lihat README).

# --- Backend (internal/config) ---------------------------------------------------------------------------------
# Port backend. Di docker compose, port ini hanya dibuka di 127.0.0.1 host; klien masuk lewat nginx.
PORT=8080
# development | production. Kosong = production.
# [PRODUKSI] ENV=production
ENV=development
AUTO_MIGRATE=true
# Seed menanam akun demo berpassword publik (docs/CREDENTIALS.md). Hanya development; ditolak di luar development.
# Nyalakan di run pertama agar admin dan data contoh terisi, lalu kembalikan ke false.
# [PRODUKSI] SEED_DATA=false
SEED_DATA=false
# Kunci penanda token login. Mengganti nilai ini membatalkan semua token dan PIN yang sudah ada.
# Buat nilai acak: openssl rand -base64 48
# (PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 })))
# [PRODUKSI] JWT_SECRET=<hasil perintah di atas>
JWT_SECRET=dev-secret-change-in-prod
# Token untuk /metrics (Prometheus). Kosong = /metrics hanya dari localhost; terisi = wajib header
# Authorization: Bearer <token>.
METRICS_TOKEN=
# Opsional: batas waktu tanpa balasan pong sebelum koneksi WebSocket diputus, dalam milidetik (bawaan 60000).
#WS_PONG_WAIT_MS=60000

# --- Admin pertama (produksi tanpa seed) -----------------------------------------------------------------------
# Dibuat saat backend start BILA belum ada admin sama sekali; aman diulang dan tidak menimpa password yang sudah
# diganti. Isi keduanya (password minimal 8 karakter), nyalakan backend, masuk, ganti password lewat tombol kunci di
# pojok kiri bawah, lalu HAPUS ADMIN_PASSWORD dari berkas ini. Buat akun petugas lain lewat menu Akun Petugas.
#ADMIN_EMAIL=ketua@lomba.id
#ADMIN_PASSWORD=
#ADMIN_NAME=Ketua Panitia

# --- PostgreSQL ------------------------------------------------------------------------------------------------
# Dipakai layanan `postgres` di compose, healthcheck, dan perakitan DB_URL di dalam container.
POSTGRES_USER=scoring_user
POSTGRES_DB=digital_scoring
# Password database. Compose berhenti bila kosong. Hanya dibaca saat volume database PERTAMA dibuat; mengubahnya
# sesudahnya tidak mengganti password database yang sudah ada (hapus volume: `docker compose down -v`, semua data
# hilang). Pakai hex/base64url saja: karakter seperti @ : / # merusak DB_URL.
# [PRODUKSI] POSTGRES_PASSWORD=<hasil: openssl rand -hex 24>   (nilai contoh di bawah ditolak backend di produksi)
POSTGRES_PASSWORD=dev_password_placeholder
# Dipakai backend dan tes saat dijalankan langsung di host (`go run`, `go test`); isi password harus sama dengan
# POSTGRES_PASSWORD. Di dalam docker compose, DB_URL dirakit otomatis dari POSTGRES_USER, POSTGRES_PASSWORD, dan
# POSTGRES_DB, jadi baris ini tidak dipakai di produksi.
DB_URL=postgres://scoring_user:dev_password_placeholder@localhost:5432/digital_scoring?sslmode=disable

# --- Port di host (docker compose) -----------------------------------------------------------------------------
# Frontend + proxy (pintu masuk utama). Dengan HTTPS, Caddy memakai 80/443, jadi frontend pindah ke loopback.
# [PRODUKSI, HTTPS] WEB_PORT=127.0.0.1:8081
WEB_PORT=80
# Nomor port saja: compose mengikat PORT (backend) dan POSTGRES_PORT ke 127.0.0.1; jangan tulis "127.0.0.1:...".
POSTGRES_PORT=5432

# --- HTTPS untuk PWA (opsional) --------------------------------------------------------------------------------
# Wajib bila tablet memasang aplikasi (PWA butuh HTTPS). Jalankan dengan `--profile https`. Lihat docs/PWA.md dan
# docs/DEPLOY-HOMESERVER.md.
#SITE_ADDRESS=silat.contoh.id
# Pilih satu mode sertifikat:
#  1) Domain di Cloudflare yang menunjuk ke IP LAN (tablet tidak perlu root CA): sertifikat lewat tantangan DNS.
#     Record A harus "DNS only" (awan abu-abu).
#TLS_DIRECTIVE=
#ACME_DNS=acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#CLOUDFLARE_API_TOKEN=
#  2) IP atau LAN tanpa domain: CA internal Caddy (root CA wajib dipasang di tiap tablet).
#TLS_DIRECTIVE=tls internal
#ACME_DNS=
#HTTP_PORT=80
#HTTPS_PORT=443
